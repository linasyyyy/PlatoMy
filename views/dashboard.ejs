<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PlatoMy</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800;900&family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #050508;
      --bg-card: #0d0814;
      --bg-card-hover: #150d21;
      --pink-accent: #F996B1;
      --pink-dark: #a84763;
      --pink-glow: rgba(249, 150, 177, 0.4);
      --pink-glow-sharp: rgba(249, 150, 177, 0.85);
      --text-main: #f0e6f5;
      --text-muted: #9e8aa8;
      --grad-chrome: linear-gradient(135deg, #ffffff 0%, #F996B1 40%, #2b0b18 100%);
      --grad-card: linear-gradient(145deg, rgba(20, 12, 28, 0.9) 0%, rgba(8, 5, 12, 0.95) 100%);
      --sidebar-width: 260px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: 'Space Grotesk', sans-serif;
      min-height: 100vh;
      display: flex;
      overflow-x: hidden;
      background-image: 
        radial-gradient(circle at 10% 20%, rgba(249, 150, 177, 0.1) 0%, transparent 35%),
        radial-gradient(circle at 90% 80%, rgba(249, 150, 177, 0.08) 0%, transparent 40%),
        linear-gradient(rgba(249, 150, 177, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(249, 150, 177, 0.03) 1px, transparent 1px);
      background-size: 100% 100%, 100% 100%, 32px 32px, 32px 32px;
    }

    /* Scanlines effect */
    body::before {
      content: "";
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%);
      background-size: 100% 4px;
      z-index: 999;
      pointer-events: none;
      opacity: 0.5;
    }

    /* Sidebar */
    .sidebar {
      width: var(--sidebar-width);
      background: rgba(8, 5, 12, 0.95);
      border-right: 1px solid rgba(249, 150, 177, 0.2);
      padding: 24px 18px;
      display: flex;
      flex-direction: column;
      position: fixed;
      height: 100vh;
      z-index: 10;
      backdrop-filter: blur(10px);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: 'Orbitron', sans-serif;
      font-weight: 900;
      font-size: 1.3rem;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 30px;
      padding-bottom: 15px;
      border-bottom: 1px solid rgba(249, 150, 177, 0.2);
    }

    .brand-logo {
      width: 38px;
      height: 38px;
      background: var(--grad-chrome);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #000;
      font-weight: 900;
      box-shadow: 0 0 12px var(--pink-glow);
    }

    .brand span {
      color: var(--pink-accent);
      text-shadow: 0 0 8px var(--pink-glow-sharp);
    }

    .user-profile-widget {
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(249, 150, 177, 0.2);
      border-radius: 8px;
      padding: 12px;
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 25px;
    }

    .user-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 2px solid var(--pink-accent);
    }

    .user-info h4 {
      font-size: 0.9rem;
      color: #fff;
    }

    .user-info p {
      font-size: 0.75rem;
      color: var(--pink-accent);
    }

    .nav-menu {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .nav-item a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      color: var(--text-muted);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9rem;
      border-radius: 6px;
      transition: all 0.25s ease;
      border: 1px solid transparent;
    }

    .nav-item a:hover, .nav-item a.active {
      color: #fff;
      background: rgba(249, 150, 177, 0.12);
      border-color: rgba(249, 150, 177, 0.4);
      text-shadow: 0 0 8px var(--pink-glow);
    }

    .nav-item a.active {
      border-left: 4px solid var(--pink-accent);
    }

    .bot-status-widget {
      margin-top: auto;
      background: rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(249, 150, 177, 0.25);
      border-radius: 8px;
      padding: 14px;
    }

    .status-indicator {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--pink-accent);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .dot-online {
      width: 8px;
      height: 8px;
      background-color: #50fa7b;
      border-radius: 50%;
      box-shadow: 0 0 8px #50fa7b;
    }

    /* Main Dashboard Area */
    .main-content {
      margin-left: var(--sidebar-width);
      flex: 1;
      padding: 30px;
      min-height: 100vh;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      padding-bottom: 20px;
      border-bottom: 1px solid rgba(249, 150, 177, 0.15);
    }

    .page-title h1 {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.8rem;
      font-weight: 900;
      text-transform: uppercase;
      background: linear-gradient(180deg, #ffffff 0%, var(--pink-accent) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .page-title p {
      color: var(--text-muted);
      font-size: 0.85rem;
    }

    .btn-cyber {
      background: var(--pink-accent);
      color: #050508;
      font-family: 'Orbitron', sans-serif;
      font-weight: 800;
      padding: 10px 20px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-size: 0.8rem;
      box-shadow: 0 0 15px var(--pink-glow);
      transition: all 0.2s ease;
      text-decoration: none;
      display: inline-block;
    }

    .btn-cyber:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 25px var(--pink-accent);
      background: #ffffff;
      color: #a84763;
    }

    .btn-outline {
      background: transparent;
      border: 1px solid var(--pink-accent);
      color: var(--pink-accent);
      font-family: 'Orbitron', sans-serif;
      font-weight: 700;
      padding: 8px 16px;
      border-radius: 4px;
      cursor: pointer;
      text-transform: uppercase;
      font-size: 0.75rem;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .btn-outline:hover {
      background: rgba(249, 150, 177, 0.15);
      box-shadow: 0 0 12px var(--pink-glow);
    }

    /* Stats Cards Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .stat-card {
      background: var(--grad-card);
      border: 1px solid rgba(249, 150, 177, 0.2);
      border-radius: 8px;
      padding: 20px;
      position: relative;
      overflow: hidden;
    }

    .stat-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: var(--grad-chrome);
    }

    .stat-label {
      color: var(--text-muted);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }

    .stat-value {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.8rem;
      font-weight: 900;
      color: #fff;
      text-shadow: 0 0 10px rgba(249, 150, 177, 0.3);
    }

    /* Panels & Layout */
    .dashboard-layout {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 25px;
    }

    @media (max-width: 992px) {
      .dashboard-layout { grid-template-columns: 1fr; }
    }

    .panel {
      background: var(--grad-card);
      border: 1px solid rgba(249, 150, 177, 0.2);
      border-radius: 10px;
      padding: 24px;
      margin-bottom: 25px;
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 1px solid rgba(249, 150, 177, 0.15);
    }

    .panel-title {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.1rem;
      color: #fff;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .panel-title span { color: var(--pink-accent); }

    /* Tables */
    .command-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }

    .command-table th {
      text-align: left;
      padding: 12px;
      color: var(--pink-accent);
      font-family: 'Orbitron', sans-serif;
      font-size: 0.75rem;
      text-transform: uppercase;
      border-bottom: 1px solid rgba(249, 150, 177, 0.2);
    }

    .command-table td {
      padding: 14px 12px;
      border-bottom: 1px solid rgba(249, 150, 177, 0.08);
      color: var(--text-main);
    }

    .command-code {
      background: rgba(0,0,0,0.5);
      border: 1px solid rgba(249, 150, 177, 0.3);
      color: var(--pink-accent);
      padding: 4px 8px;
      border-radius: 4px;
      font-family: monospace;
      font-size: 0.85rem;
    }

    /* Form Inputs */
    .cyber-form-group {
      margin-bottom: 16px;
    }

    .cyber-form-group label {
      display: block;
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .cyber-input, .cyber-select {
      width: 100%;
      background: rgba(0, 0, 0, 0.6);
      border: 1px solid rgba(249, 150, 177, 0.3);
      padding: 10px 14px;
      border-radius: 4px;
      color: #fff;
      font-family: 'Space Grotesk', sans-serif;
      outline: none;
      transition: all 0.2s ease;
    }

    .cyber-input:focus, .cyber-select:focus {
      border-color: var(--pink-accent);
      box-shadow: 0 0 10px var(--pink-glow);
    }

    .alert-box {
      margin-top: 15px;
      padding: 10px;
      border-radius: 4px;
      font-size: 0.85rem;
      display: none;
    }
  </style>
</head>
<body>

  <!-- Sidebar Nav -->
  <aside class="sidebar">
    <div class="brand">
      <div class="brand-logo">PM</div>
      Plato<span>Bot</span>
    </div>

    <div class="user-profile-widget">
      <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar" class="user-avatar" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
      <div class="user-info">
        <h4><%= user.username %></h4>
        <p>✦ Admin Cyber</p>
      </div>
    </div>

    <ul class="nav-menu">
      <li class="nav-item"><a href="#" class="active">✦ Overview</a></li>
      <li class="nav-item"><a href="#wallet-panel">💳 Wallet Control</a></li>
      <li class="nav-item"><a href="#database-panel">📊 All Wallets</a></li>
    </ul>

    <div class="bot-status-widget">
      <div class="status-indicator">
        <span class="dot-online"></span> Bot Status: Active
      </div>
      <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 6px;">Ping: <%= botClient.ws.ping %> ms</p>
    </div>
  </aside>

  <!-- Main Content Area -->
  <main class="main-content">

    <div class="top-bar">
      <div class="page-title">
        <h1>PlatoMy Bot Control Center</h1>
        <p>Pengurusan Bot & Sistem Ekonomi Komuniti PlatoMy</p>
      </div>
      <a href="/logout" class="btn-outline">🚪 Log Keluar</a>
    </div>

    <!-- Quick Stats Grid -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">Total Servers</div>
        <div class="stat-value"><%= botClient.guilds.cache.size %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Total Plato Coins</div>
        <div class="stat-value"><%= totalCoins.toLocaleString() %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Total Pips</div>
        <div class="stat-value"><%= totalPips.toLocaleString() %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Wallet Saya (Coins)</div>
        <div class="stat-value" style="color: var(--pink-accent);"><%= wallet.coins.toLocaleString() %></div>
      </div>
    </div>

    <!-- Dashboard Main Layout -->
    <div class="dashboard-layout">

      <!-- Left Column: Admin Wallet Injector -->
      <div class="left-col">
        <div class="panel" id="wallet-panel">
          <div class="panel-header">
            <h2 class="panel-title"><span>✦</span> Inject Assets / Wallet Admin</h2>
          </div>

          <form id="injectForm" onsubmit="handleInject(event)">
            <div class="cyber-form-group">
              <label>Discord ID Target</label>
              <input type="text" id="targetId" class="cyber-input" placeholder="Cth: 3829102938491" required>
            </div>

            <div class="cyber-form-group">
              <label>Jenis Aset</label>
              <select id="assetType" class="cyber-select">
                <option value="Plato Coins">🪙 Plato Coins</option>
                <option value="Pips">💠 Pips</option>
                <option value="Total Sponsor">🌸 Total Sponsor</option>
              </select>
            </div>

            <div class="cyber-form-group">
              <label>Jumlah (Amount)</label>
              <input type="number" id="amount" class="cyber-input" placeholder="Cth: 5000" required>
            </div>

            <button type="submit" class="btn-cyber" style="width: 100%;">⚡ Masukkan Aset</button>
            <div id="alertBox" class="alert-box"></div>
          </form>
        </div>
      </div>

      <!-- Right Column: My Profile Quick Info -->
      <div class="right-col">
        <div class="panel">
          <div class="panel-header">
            <h2 class="panel-title"><span>✦</span> Akaun Anda</h2>
          </div>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 15px;">Maklumat akaun Discord yang sedang log masuk:</p>
          <div style="background: rgba(0,0,0,0.5); padding: 15px; border-radius: 6px; border: 1px solid rgba(249,150,177,0.2);">
            <p>🪙 <b>Coins:</b> <%= wallet.coins.toLocaleString() %></p>
            <p style="margin-top: 8px;">💠 <b>Pips:</b> <%= wallet.pips.toLocaleString() %></p>
            <p style="margin-top: 8px;">🌸 <b>Sponsor:</b> <%= wallet.sponsorTotal.toLocaleString() %></p>
            <p style="margin-top: 8px;">✨ <b>EXP:</b> <%= wallet.exp.toLocaleString() %></p>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Full Width Panel: All Wallets Database -->
    <div class="panel" id="database-panel">
      <div class="panel-header">
        <h2 class="panel-title"><span>✦</span> Senarai Wallet Ahli Komuniti</h2>
        <span style="font-size: 0.8rem; color: var(--pink-accent);"><%= allWallets.length %> Pengguna Berdaftar</span>
      </div>

      <div style="overflow-x: auto;">
        <table class="command-table">
          <thead>
            <tr>
              <th>Discord ID</th>
              <th>Plato Coins</th>
              <th>Pips</th>
              <th>Total Sponsor</th>
              <th>EXP / Level</th>
            </tr>
          </thead>
          <tbody>
            <% if (allWallets.length === 0) { %>
              <tr>
                <td colspan="5" style="text-align: center; color: var(--text-muted);">Tiada data wallet direkodkan lagi.</td>
              </tr>
            <% } else { %>
              <% allWallets.forEach(w => { %>
                <tr>
                  <td><span class="command-code"><%= w.id %></span></td>
                  <td>🪙 <%= w.coins.toLocaleString() %></td>
                  <td>💠 <%= w.pips.toLocaleString() %></td>
                  <td>🌸 <%= w.sponsorTotal.toLocaleString() %></td>
                  <td>✨ <%= w.exp.toLocaleString() %> EXP</td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <script>
    async function handleInject(event) {
      event.preventDefault();
      const targetId = document.getElementById('targetId').value;
      const assetType = document.getElementById('assetType').value;
      const amount = document.getElementById('amount').value;
      const alertBox = document.getElementById('alertBox');

      try {
        const response = await fetch('/api/inject-assets', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ targetId, assetType, amount })
        });
        const data = await response.json();

        if (response.ok) {
          alertBox.style.display = 'block';
          alertBox.style.background = 'rgba(80, 250, 123, 0.15)';
          alertBox.style.border = '1px solid #50fa7b';
          alertBox.style.color = '#50fa7b';
          alertBox.textContent = data.message;
          setTimeout(() => location.reload(), 1500);
        } else {
          throw new Error(data.error || 'Ralat berlaku');
        }
      } catch (err) {
        alertBox.style.display = 'block';
        alertBox.style.background = 'rgba(255, 85, 85, 0.15)';
        alertBox.style.border = '1px solid #ff5555';
        alertBox.style.color = '#ff5555';
        alertBox.textContent = err.message;
      }
    }
  </script>
</body>
</html>
