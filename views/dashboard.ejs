<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#050508">
<title>PlatoMy | Komuniti Plato Malaysia</title>
<link rel="icon" href="/logo.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800;900&family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#050508;--pink:#F996B1;--pink-d:#a84763;--glow:rgba(249,150,177,.4);--text:#f0e6f5;--muted:#9e8aa8;--line:rgba(249,150,177,.2);--ok:#50fa7b;--bad:#ff5555;--sw:240px}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:'Space Grotesk',sans-serif;min-height:100vh;overflow-x:hidden;
background-image:radial-gradient(circle at 10% 10%,rgba(249,150,177,.12),transparent 35%),radial-gradient(circle at 90% 90%,rgba(249,150,177,.08),transparent 40%)}
h1,h2,h3{font-family:'Orbitron',sans-serif;text-transform:uppercase}
a{color:inherit;text-decoration:none}
button{font:inherit;cursor:pointer}

/* Navigasi */
.side{position:fixed;inset:0 auto 0 0;width:var(--sw);background:rgba(8,5,12,.98);border-right:1px solid var(--line);padding:20px 14px;display:flex;flex-direction:column;gap:6px;z-index:50}
.brand{display:flex;align-items:center;gap:10px;font-family:'Orbitron';font-weight:900;letter-spacing:2px;padding-bottom:14px;margin-bottom:8px;border-bottom:1px solid var(--line)}
.brand img{width:44px;height:44px;border-radius:50%;border:2px solid var(--pink);box-shadow:0 0 14px var(--glow)}
.brand b{color:var(--pink)}
.nb{display:flex;align-items:center;gap:10px;width:100%;text-align:left;background:none;border:1px solid transparent;color:var(--muted);padding:11px 12px;border-radius:6px;font-weight:600;font-size:.88rem;transition:.2s}
.nb:hover,.nb.active{color:#fff;background:rgba(249,150,177,.12);border-color:rgba(249,150,177,.4)}
.me{margin-top:auto;display:flex;align-items:center;gap:10px;background:rgba(0,0,0,.45);border:1px solid var(--line);border-radius:8px;padding:10px;font-size:.8rem}
.me img{width:34px;height:34px;border-radius:50%;border:2px solid var(--pink)}
.me small{color:var(--pink);display:block}
.bottom{display:none;position:fixed;inset:auto 0 0 0;z-index:50;background:rgba(8,5,12,.97);border-top:1px solid var(--line);padding:6px 4px calc(6px + env(safe-area-inset-bottom,0px));justify-content:space-around}
.bottom button{flex:1;background:none;border:0;color:var(--muted);font-size:.65rem;font-weight:600;padding:4px}
.bottom button svg{display:block;margin:0 auto 3px;width:22px;height:22px}
.bottom button.active{color:var(--pink)}

main{margin-left:var(--sw);padding:26px;max-width:1150px}
.view{display:none}.view.on{display:block}
h2{font-size:1.05rem;margin:0 0 14px;padding-bottom:8px;border-bottom:1px solid var(--line)}
h2 i{font-style:normal;color:var(--pink);margin-right:6px}
.sub{color:var(--muted);font-size:.85rem;margin:-6px 0 14px}
.grid{display:grid;gap:14px;margin-bottom:22px}
.g4{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}
.g3{grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.g2{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.card{background:linear-gradient(145deg,rgba(20,12,28,.92),rgba(8,5,12,.96));border:1px solid var(--line);border-radius:10px;padding:16px}
.card h3{font-size:.85rem;color:var(--pink);margin-bottom:10px}
.m{color:var(--muted);font-size:.82rem;line-height:1.5}

/* Hero + tiles */
.hero{display:flex;align-items:center;gap:22px;border:1px solid var(--line);border-radius:14px;padding:22px;margin-bottom:22px;background:linear-gradient(145deg,rgba(60,18,40,.55),rgba(8,5,12,.95))}
.hero img{width:140px;height:140px;border-radius:50%;border:2px solid var(--pink);box-shadow:0 0 30px var(--glow);flex-shrink:0}
.hero h1{font-size:clamp(1.6rem,5vw,2.6rem);font-weight:900;background:linear-gradient(180deg,#fff,var(--pink));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.hero p{color:var(--muted);margin:6px 0 14px}
.tile{text-align:left;color:var(--text);transition:.2s;width:100%}
.tile:hover{border-color:var(--pink);box-shadow:0 0 16px var(--glow);transform:translateY(-2px)}
.tile .ic{display:block;margin-bottom:8px;color:var(--pink)}.tile .ic svg{width:30px;height:30px}.nb svg{width:18px;height:18px;flex-shrink:0}
.tile h3{margin-bottom:4px}
.stat small{display:block;color:var(--muted);font-size:.7rem;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px}
.stat b{font-family:'Orbitron';font-size:1.45rem;font-weight:900}

/* Forms */
label{display:block;font-size:.7rem;color:var(--muted);margin-bottom:4px;text-transform:uppercase;letter-spacing:1px}
.in{width:100%;background:rgba(0,0,0,.6);border:1px solid rgba(249,150,177,.3);padding:10px 12px;border-radius:4px;color:#fff;font:inherit;font-size:.9rem;outline:none;margin-bottom:11px}
.in:focus{border-color:var(--pink);box-shadow:0 0 10px var(--glow)}
textarea.in{min-height:80px;resize:vertical}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.btn{display:inline-block;background:var(--pink);color:#050508;font-family:'Orbitron';font-weight:800;font-size:.72rem;letter-spacing:1px;text-transform:uppercase;padding:11px 16px;border:0;border-radius:4px;box-shadow:0 0 14px var(--glow);transition:.2s;text-align:center}
.btn:hover{background:#fff;color:var(--pink-d)}
.btn.line{background:transparent;color:var(--pink);border:1px solid var(--pink);box-shadow:none}
.btn.sm{padding:6px 10px;font-size:.62rem}
.btn.full{width:100%}

/* Table / lists */
.tw{overflow-x:auto;-webkit-overflow-scrolling:touch}
table{width:100%;border-collapse:collapse;font-size:.85rem;white-space:nowrap}
th{text-align:left;padding:9px;color:var(--pink);font-family:'Orbitron';font-size:.66rem;text-transform:uppercase;border-bottom:1px solid var(--line)}
td{padding:10px 9px;border-bottom:1px solid rgba(249,150,177,.08)}
code{background:rgba(0,0,0,.5);border:1px solid rgba(249,150,177,.3);color:var(--pink);padding:2px 6px;border-radius:4px;font-size:.78rem}
.rank{font-family:'Orbitron';color:var(--pink);font-weight:800}
.empty{color:var(--muted);text-align:center;padding:18px;font-size:.85rem}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.chip{background:none;border:1px solid var(--line);color:var(--muted);padding:6px 14px;border-radius:20px;font-size:.78rem;font-weight:600}
.chip.active{background:var(--pink);color:#050508;border-color:var(--pink)}
.badge{display:inline-block;font-size:.68rem;font-weight:700;padding:3px 9px;border-radius:12px;background:rgba(249,150,177,.15);border:1px solid var(--line);color:var(--pink);margin-bottom:8px}
.price{font-family:'Orbitron';font-weight:800;color:#fff;margin:6px 0}
.warn{border-left:3px solid var(--pink);padding:10px 14px;background:rgba(249,150,177,.07);font-size:.8rem;color:var(--muted);border-radius:0 6px 6px 0;margin-bottom:16px}
.rules li{list-style:none;padding:7px 0 7px 20px;position:relative;font-size:.86rem;border-bottom:1px solid rgba(249,150,177,.08)}
.rules li::before{content:"✦";position:absolute;left:0;color:var(--pink)}

#toast{position:fixed;left:50%;top:18px;transform:translateX(-50%) translateY(-120px);z-index:200;padding:11px 18px;border-radius:6px;font-size:.85rem;max-width:90vw;background:#0d0814;transition:.3s}
#toast.show{transform:translateX(-50%) translateY(0)}

@media(max-width:768px){
 .side{display:none}.bottom{display:flex}
 main{margin-left:0;padding:16px 14px 96px}
 .hero{flex-direction:column;text-align:center}.hero img{width:110px;height:110px}
 .row{grid-template-columns:1fr}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<%
const lvl = exp => { let l=1, r=200, c=exp; while(c>=r){c-=r;l++;r=l*200;} return l; };
const esc = s => String(s).replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
const chOptions = channels.map(c => `<option value="${esc(c.id)}">#${esc(c.name)} • ${esc(c.guild)}</option>`).join('');
const top10 = allWallets.slice().sort((a,b)=>b.exp-a.exp).slice(0,10);
const medals = ['🥇','🥈','🥉'];
const ICONS = {
  home:'<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  wallet:'<path d="M20 7H5a2 2 0 0 1 0-4h13v4"/><rect x="3" y="7" width="18" height="14" rx="2"/><circle cx="16.5" cy="14" r="1.2"/>',
  trading:'<path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="m3 8 9 5 9-5"/><path d="M12 13v8"/>',
  bot:'<rect x="4" y="8" width="16" height="12" rx="3"/><path d="M12 8V5"/><circle cx="12" cy="3.5" r="1.3"/><circle cx="9" cy="14" r="1.2"/><circle cx="15" cy="14" r="1.2"/>',
  info:'<path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z"/><path d="M9 9h6M9 13h6"/>'
};
const I = n => '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + ICONS[n] + '</svg>';
%>

<div id="toast"></div>

<!-- Sidebar desktop -->
<aside class="side">
  <div class="brand"><img src="/logo.jpg" alt="PlatoMy">Plato<b>My</b></div>
  <button class="nb active" data-go="home"><%- I('home') %>Utama</button>
  <button class="nb" data-go="wallet"><%- I('wallet') %>Wallet</button>
  <button class="nb" data-go="trading"><%- I('trading') %>Trading Item</button>
  <% if (isAdmin) { %><button class="nb" data-go="control"><%- I('bot') %>Kawalan Bot</button><% } %>
  <button class="nb" data-go="info"><%- I('info') %>Peraturan & Bantuan</button>
  <div class="me">
    <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
    <div><%= user.username %><small><%= isAdmin ? '✦ Admin' : '✦ Ahli' %> • <%= botClient.ws.ping %>ms</small></div>
  </div>
  <a href="/logout" class="btn line full" style="margin-top:8px">Log Keluar</a>
</aside>

<!-- Bottom nav mobile -->
<nav class="bottom">
  <button class="active" data-go="home"><%- I('home') %>Utama</button>
  <button data-go="wallet"><%- I('wallet') %>Wallet</button>
  <button data-go="trading"><%- I('trading') %>Trading</button>
  <% if (isAdmin) { %><button data-go="control"><%- I('bot') %>Bot</button><% } %>
  <button data-go="info"><%- I('info') %>Bantuan</button>
</nav>

<main>

<!-- ============ UTAMA ============ -->
<section class="view on" id="v-home">
  <div class="hero">
    <img src="/logo.jpg" alt="PlatoMy">
    <div>
      <h1>PlatoMy</h1>
      <p>Komuniti Plato Malaysia. Urus wallet, trading item dan acara di satu tempat.</p>
      <a class="btn" href="https://discord.gg/plato" target="_blank" rel="noopener">Sertai Discord</a>
    </div>
  </div>

  <div class="grid g4">
    <div class="card stat"><small>Server Bot</small><b><%= botClient.guilds.cache.size %></b></div>
    <div class="card stat"><small>Jumlah Coins</small><b><%= totalCoins.toLocaleString() %></b></div>
    <div class="card stat"><small>Jumlah Pips</small><b><%= totalPips.toLocaleString() %></b></div>
    <div class="card stat"><small>Level Anda</small><b style="color:var(--pink)"><%= lvl(wallet.exp) %></b></div>
  </div>

  <div class="grid g3">
    <button class="card tile" data-go="wallet"><span class="ic"><%- I('wallet') %></span><h3>Wallet Saya</h3><p class="m">Semak coins, pips, EXP dan papan pendahulu.</p></button>
    <button class="card tile" data-go="trading"><span class="ic"><%- I('trading') %></span><h3>Trading Item</h3><p class="m">Jual, beli atau tukar item Plato dengan ahli lain.</p></button>
    <% if (isAdmin) { %><button class="card tile" data-go="control"><span class="ic"><%- I('bot') %></span><h3>Kawalan Bot</h3><p class="m">Cipta event, giveaway, rumble dan embed terus dari web.</p></button><% } %>
    <button class="card tile" data-go="info"><span class="ic"><%- I('info') %></span><h3>Peraturan & Bantuan</h3><p class="m">Panduan komuniti dan hubungi pasukan sokongan.</p></button>
  </div>
</section>

<!-- ============ WALLET ============ -->
<section class="view" id="v-wallet">
  <h2><i>✦</i>Wallet Saya</h2>
  <div class="grid g4">
    <div class="card stat"><small>🪙 Plato Coins</small><b><%= wallet.coins.toLocaleString() %></b></div>
    <div class="card stat"><small>💠 Pips</small><b><%= wallet.pips.toLocaleString() %></b></div>
    <div class="card stat"><small>🌸 Sponsor</small><b><%= wallet.sponsorTotal.toLocaleString() %></b></div>
    <div class="card stat"><small>✨ EXP (Lv <%= lvl(wallet.exp) %>)</small><b><%= wallet.exp.toLocaleString() %></b></div>
  </div>

  <h2><i>✦</i>Papan Pendahulu EXP</h2>
  <div class="card tw" style="padding:6px;margin-bottom:22px">
    <table>
      <thead><tr><th>#</th><th>Ahli</th><th>Level</th><th>EXP</th></tr></thead>
      <tbody>
      <% if (top10.length === 0) { %><tr><td colspan="4" class="empty">Belum ada rekod.</td></tr>
      <% } else { top10.forEach((w,i) => { %>
        <tr><td class="rank"><%= medals[i] || (i+1) %></td><td><%= w.name %></td><td><%= lvl(w.exp) %></td><td>✨ <%= w.exp.toLocaleString() %></td></tr>
      <% }) } %>
      </tbody>
    </table>
  </div>

  <% if (isAdmin) { %>
  <h2><i>✦</i>Semua Wallet <span style="float:right;font-size:.72rem;color:var(--pink);font-family:'Space Grotesk';text-transform:none"><%= allWallets.length %> pengguna</span></h2>
  <input type="search" id="walletSearch" class="in" placeholder="Cari nama atau Discord ID...">
  <div class="card tw" style="padding:6px">
    <table id="walletTable">
      <thead><tr><th>Ahli</th><th>Discord ID</th><th>Coins</th><th>Pips</th><th>Sponsor</th><th>EXP</th></tr></thead>
      <tbody>
      <% if (allWallets.length === 0) { %><tr><td colspan="6" class="empty">Tiada data wallet lagi.</td></tr>
      <% } else { allWallets.slice().sort((a,b)=>b.coins-a.coins).forEach(w => { %>
        <tr><td><%= w.name %></td><td><code><%= w.id %></code></td><td>🪙 <%= w.coins.toLocaleString() %></td><td>💠 <%= w.pips.toLocaleString() %></td><td>🌸 <%= w.sponsorTotal.toLocaleString() %></td><td>✨ <%= w.exp.toLocaleString() %></td></tr>
      <% }) } %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<!-- ============ TRADING ============ -->
<section class="view" id="v-trading">
  <h2><i>✦</i>Trading Item Plato</h2>
  <div class="warn">⚠️ PlatoMy hanya memaparkan listing. Urus transaksi sendiri dalam Plato dan berhati-hati dengan penipuan. Jangan kongsi kata laluan akaun.</div>

  <div class="grid g2">
    <div class="card">
      <h3>Pasang Listing Baharu</h3>
      <form data-api="/api/trade" data-reload="1">
        <label>Nama item</label>
        <input class="in" name="item" maxlength="80" placeholder="Cth: Bingkai Sakura Limited" required>
        <div class="row">
          <div><label>Jenis</label>
            <select class="in" name="type"><option value="jual">💰 Jual</option><option value="beli">🛒 Beli</option><option value="tukar">🔄 Tukar</option></select></div>
          <div><label>Mata wang</label>
            <select class="in" name="currency"><option>Coins</option><option>Pips</option><option>RM</option><option>Tukar item</option></select></div>
        </div>
        <label>Harga / tawaran (kosong = runding)</label>
        <input class="in" name="price" maxlength="40" placeholder="Cth: 5000">
        <label>Nota</label>
        <textarea class="in" name="notes" maxlength="300" placeholder="Keadaan item, masa online, dll."></textarea>
        <button class="btn full" type="submit">📦 Paparkan Listing</button>
      </form>
    </div>

    <div class="card">
      <h3>Cara Guna</h3>
      <ul class="rules">
        <li>Isi borang, listing anda terus dipaparkan dan dihantar ke channel trading-log.</li>
        <li>Pembeli tekan <b>Hubungi</b> untuk buka profil Discord anda.</li>
        <li>Selepas selesai, tekan <b>Selesai</b> supaya listing hilang.</li>
        <li>Maksimum 5 listing aktif setiap ahli.</li>
      </ul>
    </div>
  </div>

  <div class="chips">
    <button class="chip active" data-filter="all">Semua</button>
    <button class="chip" data-filter="jual">💰 Jual</button>
    <button class="chip" data-filter="beli">🛒 Beli</button>
    <button class="chip" data-filter="tukar">🔄 Tukar</button>
  </div>

  <div class="grid g3" id="tradeGrid">
    <% const T = {jual:'💰 Jual',beli:'🛒 Beli',tukar:'🔄 Tukar'}; %>
    <% if (listings.length === 0) { %>
      <div class="card empty" style="grid-column:1/-1">Belum ada listing. Jadilah yang pertama!</div>
    <% } else { listings.forEach(l => { %>
      <div class="card" data-type="<%= l.type %>">
        <span class="badge"><%= T[l.type] %></span>
        <h3 style="margin-bottom:2px"><%= l.item %></h3>
        <div class="price"><%= l.price ? l.price + ' ' + l.currency : 'Runding' %></div>
        <p class="m"><%= l.notes || 'Tiada nota.' %></p>
        <p class="m" style="margin-top:8px">👤 <%= l.username %></p>
        <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap">
          <a class="btn sm" href="https://discord.com/users/<%= l.userId %>" target="_blank" rel="noopener">💬 Hubungi</a>
          <% if (l.userId === user.id || isAdmin) { %>
            <button class="btn sm line" data-trade="close" data-id="<%= l.id %>">✔ Selesai</button>
            <button class="btn sm line" data-trade="delete" data-id="<%= l.id %>">🗑 Padam</button>
          <% } %>
        </div>
      </div>
    <% }) } %>
  </div>
</section>

<!-- ============ KAWALAN BOT ============ -->
<% if (isAdmin) { %>
<section class="view" id="v-control">
  <h2><i>✦</i>Kawalan Bot Discord</h2>
  <p class="sub">Semua tindakan dihantar terus ke channel pilihan anda melalui bot.</p>
  <% if (channels.length === 0) { %><div class="warn">Bot tidak menjumpai sebarang text channel. Pastikan bot berada dalam server.</div><% } %>

  <div class="grid g2">
    <div class="card"><h3>🎉 Cipta Event</h3>
      <form data-api="/api/bot/event">
        <label>Channel</label><select class="in" name="channelId" required><%- chOptions %></select>
        <label>Tajuk</label><input class="in" name="title" maxlength="100" required>
        <label>Butiran</label><textarea class="in" name="description" maxlength="1500" required></textarea>
        <button class="btn full" type="submit">Umumkan Event</button>
      </form></div>

    <div class="card"><h3>🎁 Mula Giveaway</h3>
      <form data-api="/api/bot/giveaway">
        <label>Channel</label><select class="in" name="channelId" required><%- chOptions %></select>
        <label>Hadiah</label><input class="in" name="prize" maxlength="200" required>
        <div class="row">
          <div><label>Tempoh (minit)</label><input class="in" type="number" name="duration" min="1" max="10080" value="60" required></div>
          <div><label>Pemenang</label><input class="in" type="number" name="winners" min="1" max="20" value="1" required></div>
        </div>
        <label>Syarat (pilihan)</label><input class="in" name="requirement" maxlength="200">
        <label>URL imej (pilihan)</label><input class="in" name="image" placeholder="https://...">
        <button class="btn full" type="submit">Mula Giveaway</button>
      </form></div>

    <div class="card"><h3>🌸 Mula Rumble</h3>
      <form data-api="/api/bot/rumble">
        <label>Channel</label><select class="in" name="channelId" required><%- chOptions %></select>
        <div class="row">
          <div><label>Mata wang</label><select class="in" name="currency"><option value="coins">🪙 Plato Coins</option><option value="pips">💠 Pips</option></select></div>
          <div><label>Hadiah</label><input class="in" type="number" name="prize" min="1" required></div>
        </div>
        <label>Tempoh (minit)</label><input class="in" type="number" name="duration" min="1" max="10080" value="10" required>
        <button class="btn full" type="submit">Mula Rumble</button>
      </form></div>

    <div class="card"><h3>📢 Hantar Embed</h3>
      <form data-api="/api/bot/announce">
        <label>Channel</label><select class="in" name="channelId" required><%- chOptions %></select>
        <label>Tajuk</label><input class="in" name="title" maxlength="200">
        <label>Mesej</label><textarea class="in" name="message" maxlength="3000"></textarea>
        <div class="row">
          <div><label>Warna Hex</label><input class="in" name="color" value="#ff69b4" maxlength="7"></div>
          <div><label>URL imej</label><input class="in" name="image" placeholder="https://..."></div>
        </div>
        <button class="btn full" type="submit">Hantar Embed</button>
      </form></div>

    <div class="card"><h3>💳 Urus Wallet Ahli</h3>
      <form data-api="/api/wallet/adjust">
        <label>Discord ID sasaran</label><input class="in" name="targetId" inputmode="numeric" placeholder="Cth: 3829102938491" required>
        <div class="row">
          <div><label>Aset</label><select class="in" name="assetType"><option value="coins">🪙 Plato Coins</option><option value="pips">💠 Pips</option><option value="sponsor">🌸 Total Sponsor</option></select></div>
          <div><label>Tindakan</label><select class="in" name="action"><option value="add">Tambah</option><option value="deduct">Tolak</option></select></div>
        </div>
        <label>Jumlah</label><input class="in" type="number" name="amount" min="1" required>
        <label>Sebab (pilihan)</label><input class="in" name="reason" maxlength="200">
        <button class="btn full" type="submit">⚡ Laksana</button>
      </form></div>
  </div>
</section>
<% } %>

<!-- ============ INFO ============ -->
<section class="view" id="v-info">
  <h2><i>✦</i>Peraturan Komuniti</h2>
  <div class="grid g3 rules">
    <div class="card"><h3>Umum</h3><ul>
      <li>Dilarang eksploit app atau ganggu pengguna lain.</li>
      <li>Dilarang tukar-menang atau manipulasi ranking.</li>
      <li>Dilarang guna perisian pihak ketiga.</li>
      <li>Dilarang jual beli akaun dengan wang sebenar.</li></ul></div>
    <div class="card"><h3>Chat Bilik Awam</h3><ul>
      <li>Tiada kandungan lucah atau haram.</li>
      <li>Jangan kongsi maklumat peribadi orang lain.</li>
      <li>Tiada spam. Gunakan Bahasa Melayu.</li>
      <li>Tiada galakan keganasan atau kebencian.</li></ul></div>
    <div class="card"><h3>Gambar Profil</h3><ul>
      <li>Tiada kandungan lucah atau berdarah.</li>
      <li>Tiada simbol kebencian.</li>
      <li>Tiada gangguan atau penyamaran.</li></ul></div>
  </div>

  <h2><i>✦</i>Hubungi Sokongan</h2>
  <div class="card" style="max-width:560px">
    <p class="m" style="margin-bottom:12px">Jumpa bug atau ada masalah? Mesej anda dihantar terus ke <b style="color:var(--pink)"><%= supportEmail %></b>.</p>
    <form id="mailForm">
      <label>Subjek</label>
      <select class="in" id="mSubject"><option>Laporan Bug</option><option>Aduan Ahli</option><option>Masalah Wallet</option><option>Lain-lain</option></select>
      <label>Mesej</label>
      <textarea class="in" id="mBody" required placeholder="Terangkan masalah anda..."></textarea>
      <button class="btn full" type="submit">✉ Hantar E-mel</button>
    </form>
  </div>
</section>

</main>

<script>
const USER = <%- JSON.stringify({ id: user.id, username: user.username }) %>;
const SUPPORT = <%- JSON.stringify(supportEmail) %>;

/* Navigasi tab (butang -> halaman) */
function go(v){
  if(!document.getElementById('v-'+v)) v='home';
  document.querySelectorAll('.view').forEach(e=>e.classList.toggle('on',e.id==='v-'+v));
  document.querySelectorAll('[data-go]').forEach(b=>{ if(b.classList.contains('nb')||b.closest('.bottom')) b.classList.toggle('active',b.dataset.go===v); });
  history.replaceState(null,'','#'+v);
  window.scrollTo(0,0);
}
document.addEventListener('click',e=>{ const b=e.target.closest('[data-go]'); if(b){ go(b.dataset.go); } });
go(location.hash.slice(1)||'home');

/* Toast */
function toast(ok,msg){
  const t=document.getElementById('toast');
  t.textContent=msg; t.style.border='1px solid '+(ok?'var(--ok)':'var(--bad)'); t.style.color=ok?'var(--ok)':'var(--bad)';
  t.classList.add('show'); clearTimeout(t._h); t._h=setTimeout(()=>t.classList.remove('show'),3500);
}

async function post(url,body){
  const res=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body||{})});
  let data={}; try{ data=await res.json(); }catch{}
  if(!res.ok) throw new Error(data.error||'Ralat berlaku');
  return data;
}

/* Semua borang dengan data-api */
document.querySelectorAll('form[data-api]').forEach(f=>{
  f.addEventListener('submit',async e=>{
    e.preventDefault();
    const btn=f.querySelector('button[type=submit]'); btn.disabled=true;
    try{
      const d=await post(f.dataset.api,Object.fromEntries(new FormData(f)));
      toast(true,d.message||'Berjaya!');
      if(f.dataset.reload) setTimeout(()=>{ location.hash='trading'; location.reload(); },900); else f.reset();
    }catch(err){ toast(false,err.message); }
    btn.disabled=false;
  });
});

/* Trading: tapis + tindakan */
document.querySelectorAll('.chip').forEach(c=>c.addEventListener('click',()=>{
  document.querySelectorAll('.chip').forEach(x=>x.classList.toggle('active',x===c));
  document.querySelectorAll('#tradeGrid [data-type]').forEach(card=>{
    card.style.display=(c.dataset.filter==='all'||card.dataset.type===c.dataset.filter)?'':'none';
  });
}));
document.querySelectorAll('[data-trade]').forEach(b=>b.addEventListener('click',async()=>{
  if(b.dataset.trade==='delete' && !confirm('Padam listing ini?')) return;
  try{ const d=await post('/api/trade/'+b.dataset.id+'/'+b.dataset.trade); toast(true,d.message); setTimeout(()=>location.reload(),700); }
  catch(err){ toast(false,err.message); }
}));

/* Carian wallet */
const ws=document.getElementById('walletSearch');
if(ws) ws.addEventListener('input',()=>{
  const q=ws.value.trim().toLowerCase();
  document.querySelectorAll('#walletTable tbody tr').forEach(tr=>{ tr.style.display=tr.textContent.toLowerCase().includes(q)?'':'none'; });
});

/* E-mel terus ke hello@platoteam.com */
document.getElementById('mailForm').addEventListener('submit',e=>{
  e.preventDefault();
  const subject='[PlatoMy] '+document.getElementById('mSubject').value;
  const body=document.getElementById('mBody').value+'\n\n---\nDiscord: '+USER.username+' ('+USER.id+')';
  location.href='mailto:'+SUPPORT+'?subject='+encodeURIComponent(subject)+'&body='+encodeURIComponent(body);
});
</script>
</body>
</html>
